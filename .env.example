# ==============================================================================
# TAPSTARS ENVIRONMENT CONFIGURATION
# ==============================================================================
# For local testing, copy this file to .env
# For Cloudflare Pages production, enter these under Project Settings -> Environment Variables.

# 1. Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (Safe for browser/frontend usage with RLS enabled)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Permanent Base URL for physical NFC cards and QR codes
# Default target: https://tapstars.pages.dev (free Cloudflare pages.dev subdomain)
VITE_APP_BASE_URL=https://tapstars.pages.dev

# 4. Optional Cloudflare Pages Functions server-side variables (auto-inherited)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
